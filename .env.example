# ─── Clerk Authentication ─────────────────────────────────────────────────────
# From https://dashboard.clerk.com → Configure your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx...
CLERK_SECRET_KEY=sk_test_xxxx...

# ─── Supabase ──────────────────────────────────────────────────────────────────
# From https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Meta Webhook ─────────────────────────────────────────────────────────────
# A secret string YOU invent. Enter this exact value in Meta dashboard → Webhooks → Verify Token.
META_WEBHOOK_VERIFY_TOKEN=my_super_secret_verify_token_123

# ─── Instagram (Messenger Platform) ──────────────────────────────────────────
# From Meta dashboard: your App → Instagram → Instagram Accounts → Generate Token
# Required permissions: pages_messaging, instagram_manage_messages
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxx

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────
# From Meta dashboard: your App → WhatsApp → API Setup → "Temporary access token" (test)
# or System User token for production (never expires)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxx

# The Phone Number ID shown in Meta dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# ─── Google Gemini API ─────────────────────────────────────────────────────────
# From https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# Gemini model to use. gemini-2.0-flash is latest and fastest.
# Options: gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro
GOOGLE_MODEL=gemini-2.0-flash

# ─── Inbound AI voice calls (Twilio <-> Gemini Live bridge) ──────────────────
# Which agent's profile/system_prompt the shared inbound number uses. One
# number for the whole platform for now — per-agent numbers are a later
# feature. Find an agent's id in the dashboard or the `agents` table.
DEFAULT_VOICE_AGENT_ID=

# WebSocket URL of the deployed voice bridge service (separate repo/deploy,
# e.g. Fly.io or Railway) that Twilio's <Connect><Stream> points at.
VOICE_BRIDGE_WS_URL=wss://your-bridge.fly.dev/twilio-stream

# Shared secret the bridge sends as `Authorization: Bearer <this>` when it
# calls back into this app (voice-session-config, book-appointment). Generate
# a random string; must match on both sides.
BRIDGE_SHARED_SECRET=

# ─── Business context (optional) ─────────────────────────────────────────────
# A short description injected into the system prompt for every conversation.
# Example: "Glamour Nails Studio, located in Austin TX. Services: manicure ($35),
# pedicure ($45), gel nails ($55). Open Mon-Sat 9am-7pm."
BUSINESS_CONTEXT=

# ─── Outbound dialer at /dashboard/dialer (Zadarma callback API) ─────────────
# From Zadarma dashboard → Settings → API. Zadarma rings ZADARMA_CALLER_PHONE
# first; once you answer, it dials the number you typed in and bridges the
# two legs. No browser mic/WebRTC needed.
ZADARMA_API_KEY=
ZADARMA_API_SECRET=

# Your own phone number (E.164, e.g. +15551234567) — the one Zadarma calls
# first before connecting you to the lead.
ZADARMA_CALLER_PHONE=

# ─── (Unused) Twilio browser dialer at /dashboard/dialer ─────────────────────
# Superseded by the Zadarma callback dialer above — Twilio required business
# entity verification to place outbound calls, which blocked this path. Left
# here (routes still exist) in case Twilio verification gets completed later.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_TWIML_APP_SID=
# TWILIO_PHONE_NUMBER=
