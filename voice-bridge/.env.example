# ─── Google Gemini Live API ────────────────────────────────────────────────
# From https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# Primary model, falls back automatically on 404/deprecation to
# GEMINI_LIVE_FALLBACK_MODEL. Verify current model names against
# https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_FALLBACK_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# ─── Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# ─── Iupiter app (service-to-service) ─────────────────────────────────────
# The main Next.js app's URL, and the shared secret both sides use to
# authenticate calls to voice-session-config / book-appointment. Must match
# BRIDGE_SHARED_SECRET in the main app's env exactly.
IUPITER_APP_URL=https://iupiter.vercel.app
BRIDGE_SHARED_SECRET=

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8080
