{
  "name": "iupiter-voice-bridge",
  "version": "1.0.0",
  "description": "Bridges inbound Twilio phone calls to Google's Gemini Live API for real-time voice conversations with an Iupiter AI real estate agent.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@google/genai": "^2.11.0",
    "twilio": "^6.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
